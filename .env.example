# Copy to .env and set strong values. Never commit the real .env.
# Passwords are embedded in PostgreSQL URLs, so use URL-safe characters
# (letters, digits, '-', '_') or percent-encode reserved characters.

# --- Database ---
POSTGRES_DB=uzex
POSTGRES_PASSWORD=replace_with_long_random_owner_password
UZEX_READER_PASSWORD=replace_with_long_random_reader_password

# --- Public web ---
WEB_PORT=8080
# Browser origins allowed to call the API directly (comma separated).
# When the React app is served by the bundled nginx, requests are same-origin
# and CORS is not exercised.
CORS_ORIGINS=http://localhost:8080

# --- Application ---
APP_SECRET=replace_with_long_random_secret
DATASET_CUTOFF_DATE=2026-10-30
RATE_LIMIT_PER_MINUTE=30
SQL_TIMEOUT_MS=8000

# --- Planner ---
# local = deterministic offline planner (no external calls)
# llm   = strict QueryPlan through Groq GPT-OSS 120B
PLANNER_MODE=local
LLM_PROVIDER=groq
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
# Server-only. Never expose these values to the frontend or commit them.
GROQ_API_KEY=
# Credential redundancy only, same authorized organization/project.
# Never used to bypass HTTP 429 quota; rotation is 401-only.
GROQ_API_KEY_SECONDARY=
GROQ_API_KEY_SECONDARY_SAME_ORG=
GROQ_API_KEY_TERTIARY_SAME_ORG=
GROQ_ORGANIZATION_SCOPE_ID=groq-default-org
GROQ_PROJECT_SCOPE_ID=groq-default-project
# Optional second organization used only after the primary organization has
# exhausted its daily quota. Comma-separated; never merged with the keys above.
GROQ_FAILOVER_API_KEYS=
GROQ_FAILOVER_ORGANIZATION_SCOPE_ID=
GROQ_FAILOVER_PROJECT_SCOPE_ID=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_CHAIN=
LLM_MODEL_FALLBACK_CHAIN=
LLM_FALLBACK_MAX_HOPS=2
LLM_QUALIFICATION_REQUIRED=true
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=900
LLM_RETRY_ONCE=true

# --- General AI Mode ---
# The LLM planner may answer non-registry questions conversationally and may
# append a clearly labelled hypothesis block after verified SQL facts.
# General answers never carry data/evidence and are never database claims.
GENERAL_MODE_ENABLED=true
GENERAL_ANSWER_MAX_CHARS=2000
EXPLANATION_MODE=llm
EXPLANATION_MAX_CHARS=900

# --- Reliability (V2.1) ---
# One breaker per provider:model:organization:project scope.
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RECOVERY_SECONDS=60
# 429 resets <= this value are "short"; longer/absent resets fail closed.
LLM_RATE_LIMIT_SHORT_MAX_SECONDS=60
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_MAX_QUEUE_WAIT_SECONDS=5
# Wait once for a short 429 reset at most this long, then fail closed.
LLM_INLINE_COOLDOWN_WAIT_SECONDS=2

# --- Plan critic ---
# off = never call a second model; risk_based only narrows risky EXECUTE plans.
LLM_PLAN_CRITIC_MODE=off

# --- Hybrid RAG ---
# Indexes approved documentation only, never deal rows or facts.
LLM_RAG_ENABLED=false
LLM_RAG_TOP_K=5
LLM_RAG_MIN_RELEVANCE=0.12
