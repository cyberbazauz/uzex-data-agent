# syntax=docker/dockerfile:1
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Runtime state directory for the Telegram worker.  Creating it in the image
# means a fresh named volume inherits the app user's ownership instead of
# being created as root.
RUN mkdir -p /app/runtime

# psycopg2 is installed as a binary wheel, so no build toolchain is needed.
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
COPY backend/importer ./importer
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY data/manifests/uzex_spot_data.expected.json ./data/manifests/uzex_spot_data.expected.json

RUN pip install .

RUN groupadd --system app && useradd --system --gid app --home /app app \
    && chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import json,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4); assert json.load(r)['status']=='ok'"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
