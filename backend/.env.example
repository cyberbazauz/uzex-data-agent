# Server-only configuration. Never expose these values to the browser.
# Copy to backend/.env for local development.

APP_ENV=development
APP_SECRET=replace_with_long_random_secret
DATASET_CUTOFF_DATE=2026-10-30

# Importer / owner role (DDL + writes). Used only by the import CLI.
DATABASE_URL=postgresql+psycopg2://uzex_owner:uzex_owner_dev_password@127.0.0.1:55432/uzex

# Runtime role: SELECT only.
DATABASE_READONLY_URL=postgresql+psycopg2://uzex_reader:uzex_reader_dev_password@127.0.0.1:55432/uzex

# Planner backend: "local" (deterministic, no network) or "llm".
PLANNER_MODE=local

# --- General AI Mode ---
# With an LLM planner the same provider may answer non-registry questions
# conversationally.  Such answers carry no data/evidence and are never
# presented as PostgreSQL facts.  The local planner never emits GENERAL.
GENERAL_MODE_ENABLED=true
GENERAL_ANSWER_MAX_CHARS=2000
# "llm" appends a clearly labelled hypothesis block after a verified data
# answer.  The block is validated and may not add facts or numbers.
EXPLANATION_MODE=llm
EXPLANATION_MAX_CHARS=900

# --- Groq (V2.1 production primary: GPT-OSS 120B) ---
# Server-only. Never expose these values to the browser or commit them.
LLM_PROVIDER=groq
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Credential redundancy only. Every key MUST belong to the same authorized
# Groq organization/project. These keys are NOT a quota pool: the runtime never
# rotates them on HTTP 429. Rotation happens only after a credential-specific
# 401 invalid/revoked-key error.
GROQ_API_KEY_SECONDARY_SAME_ORG=
GROQ_API_KEY_TERTIARY_SAME_ORG=
GROQ_ORGANIZATION_SCOPE_ID=groq-default-org
GROQ_PROJECT_SCOPE_ID=groq-default-project
# Optional independent organization. Used only after a long (daily) quota
# exhaustion in the primary organization; never mixed with the keys above.
GROQ_FAILOVER_API_KEYS=
GROQ_FAILOVER_ORGANIZATION_SCOPE_ID=
GROQ_FAILOVER_PROJECT_SCOPE_ID=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback chain: provider:model,provider:model. Empty by default. A fallback is
# used only when its qualification report is present (LLM_QUALIFICATION_REQUIRED).
# LLM_MODEL_FALLBACK_CHAIN is same-provider model redundancy on the SAME keys
# (for example qwen/qwen3.8-27b); it is tried before the cross-provider chain.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_CHAIN=
LLM_MODEL_FALLBACK_CHAIN=
LLM_FALLBACK_MAX_HOPS=2
LLM_QUALIFICATION_REQUIRED=true

# Reliability thresholds.
LLM_RETRY_ONCE=true
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=900
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RECOVERY_SECONDS=60
LLM_RATE_LIMIT_SHORT_MAX_SECONDS=60
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_MAX_QUEUE_WAIT_SECONDS=5
LLM_INLINE_COOLDOWN_WAIT_SECONDS=2

# --- Gemini (legacy, disabled by default; no keys in production) ---
# The adapter code remains for rollback, but V2.1 does not configure Gemini.
# GEMINI_API_KEY=
# GEMINI_API_KEY_SECONDARY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_SCHEMA_MODE=json_schema

# --- Generic OpenAI-compatible provider (optional laboratory transport) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# Public CORS origins for the React app (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30

# --- Telegram long-polling worker (server-side only) ---
# Never commit a real token; set it only in the server-side .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_STATE_DB=/app/runtime/telegram_state.sqlite3
TELEGRAM_HEARTBEAT_PATH=/app/runtime/telegram.heartbeat
TELEGRAM_MAX_INPUT_CHARS=1000
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
